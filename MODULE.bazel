module(
    name = "sonic-sairedis",
    version = "1.0.0",
)

# Versions aligned with sonic-dzf/MODULE.bazel and src/sonic-swss-common/MODULE.bazel
# so that Bzlmod resolves a single, consistent graph across the workspace.
bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")

bazel_dep(name = "sonic-build-infra", version = "0.0.0", repo_name = "sonic_build_infra")
bazel_dep(name = "rules_distroless", version = "0.0.0", repo_name = "rules_deb")

bazel_dep(name = "libnl3", version = "3.7.0")
bazel_dep(name = "libyang3", version = "3.12.2")
bazel_dep(name = "sonic-swss-common", version = "1.0.0")

# SAI is exposed as a nested Bzlmod module via a wrapper directory at
# src/sonic-sairedis/SAI-bazel which fetches the upstream SAI v1.18.1 tarball
# through sonic_http_archive.  Bzlmod only honours root-level
# local_path_override (see mig_docs/lessonlearned/sonic-sairedis_lessonlearned.md
# Lesson 1); the effective override is declared in the root MODULE.bazel.  The
# entry here is retained so `bazel build` from this directory during
# development still resolves consistently.
bazel_dep(name = "sai", version = "0.0.0")
local_path_override(
    module_name = "sai",
    path = "SAI-bazel",
)

# Python + SWIG toolchains for pyext/pysairedis. The root MODULE.bazel already
# registers rules_python 1.7.0 with a 3.13 default toolchain (matching trixie's
# system libpython3.13); we consume `current_py_cc_headers`/`current_py_cc_libs`
# just like sonic-swss-common's _swsscommon extension does.
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "swig", version = "4.1.0")

# Build-time apt deps. Submodule declares its own sources_list + install so
# BUILD files can reference @sairedis_deps//... directly without root module.
apt = use_extension("@rules_deb//apt:extensions.bzl", "apt")
apt.sources_list(
    architectures = ["amd64", "arm64"],
    components = ["main"],
    suites = ["trixie", "trixie-updates"],
    uris = ["https://snapshot.debian.org/archive/debian/20260409T202916Z"],
)
apt.sources_list(
    architectures = ["amd64", "arm64"],
    components = ["main"],
    suites = ["trixie-security"],
    uris = ["https://snapshot.debian.org/archive/debian-security/20260409T182303Z"],
)
apt.install(
    dependency_set = "sairedis_deps",
    packages = [
        "libhiredis-dev:amd64",
        "libhiredis-dev:arm64",
        "libzmq3-dev:amd64",
        "libzmq3-dev:arm64",
        "zlib1g-dev:amd64",
        "zlib1g-dev:arm64",
    ],
    suites = ["trixie", "trixie-updates", "trixie-security"],
)
use_repo(apt, "sairedis_deps")
